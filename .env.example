# settlement configuration.
#
# Copy to .env and fill in. Every variable is read at startup and validated:
# a misconfigured billing service refuses to boot rather than discovering the
# problem halfway through an invoice lifecycle.

# ---------------------------------------------------------------------------
# Kafka — shared by the producer, the worker and settlementctl
# ---------------------------------------------------------------------------

SETTLEMENT_KAFKA_BROKERS=localhost:19092

# Billing topics live apart from OpenMeter's usage-ingest topics, ideally on a
# separate cluster: usage is high volume and loss tolerant, billing is
# financial and must never queue behind a usage spike.
SETTLEMENT_KAFKA_TOPIC_STRIPE=billing.stripe.events.v1
SETTLEMENT_KAFKA_TOPIC_OPENMETER=billing.openmeter.invoices.v1
SETTLEMENT_KAFKA_TOPIC_DLQ=billing.settlement.dlq.v1

SETTLEMENT_KAFKA_CONSUMER_GROUP=settlement-worker

# -1 (all in-sync replicas) is the only durable setting for financial events.
# Lower it only on a single-broker development cluster.
SETTLEMENT_KAFKA_REQUIRED_ACKS=-1
SETTLEMENT_KAFKA_WRITE_TIMEOUT=10s
SETTLEMENT_KAFKA_DIAL_TIMEOUT=10s

# Managed clusters (Confluent, Redpanda Cloud, Aiven):
# SETTLEMENT_KAFKA_TLS=true
# SETTLEMENT_KAFKA_SASL_MECHANISM=scram-sha-512
# SETTLEMENT_KAFKA_SASL_USERNAME=
# SETTLEMENT_KAFKA_SASL_PASSWORD=

# ---------------------------------------------------------------------------
# Producer (the doorman)
# ---------------------------------------------------------------------------

SETTLEMENT_HTTP_ADDR=:8080
SETTLEMENT_MAX_BODY_BYTES=1048576

# Comma-separated so a secret can be rotated without a delivery gap: add the
# new one, roll the endpoint, then drop the old.
SETTLEMENT_STRIPE_WEBHOOK_SECRETS=whsec_replace_me
SETTLEMENT_STRIPE_TOLERANCE_SECONDS=300

# OpenMeter notification channel signing secret (Standard Webhooks / Svix).
SETTLEMENT_OPENMETER_WEBHOOK_SECRETS=whsec_replace_me
SETTLEMENT_OPENMETER_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

SETTLEMENT_METRICS_ADDR=:8081
SETTLEMENT_SHUTDOWN_TIMEOUT=30s

# Ordered execution lanes. Messages are dispatched by hash(partition key), so
# one customer's events stay serialized while unrelated customers run in
# parallel. Raise for throughput, not for latency.
SETTLEMENT_LANES=16
SETTLEMENT_LANE_BUFFER=64

SETTLEMENT_MAX_ATTEMPTS=8
SETTLEMENT_RETRY_BASE_DELAY=500ms
SETTLEMENT_RETRY_MAX_DELAY=60s
SETTLEMENT_RETRY_JITTER=0.2
SETTLEMENT_COMMIT_INTERVAL=1s

# dlq  — park the message, commit the offset, keep the partition flowing.
#        Requires alerting on settlement_dead_lettered_total.
# halt — stop without committing. Nothing is lost and nothing proceeds.
SETTLEMENT_ON_RETRY_EXHAUSTED=dlq

# first replays a topic from the beginning for a brand-new consumer group.
SETTLEMENT_START_OFFSET=last

# ---------------------------------------------------------------------------
# Idempotency store
# ---------------------------------------------------------------------------

# Required for more than one worker replica: without it each replica keeps its
# own in-process claim map and both would process the same event.
SETTLEMENT_REDIS_URL=redis://localhost:6379/0
SETTLEMENT_DEDUPE_TTL=720h
SETTLEMENT_DEDUPE_PREFIX=settlement:dedupe:
SETTLEMENT_DEDUPE_TIMEOUT=3s

# ---------------------------------------------------------------------------
# OpenMeter
# ---------------------------------------------------------------------------

SETTLEMENT_OPENMETER_URL=http://127.0.0.1:48888
SETTLEMENT_OPENMETER_API_KEY=
SETTLEMENT_OPENMETER_TIMEOUT=20s

# The extendedStatus values that mean "waiting on us". They are configurable
# because extendedStatus is a free-form string in the OpenMeter API; verify
# them against your deployment before going live.
SETTLEMENT_OPENMETER_DRAFT_SYNC_STATUSES=draft.sync,draft_sync,draft.syncing
SETTLEMENT_OPENMETER_ISSUING_SYNC_STATUSES=issuing.sync,issuing_sync,issuing.syncing
SETTLEMENT_OPENMETER_PAYMENT_PENDING_STATUSES=payment_processing.pending

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

SETTLEMENT_STRIPE_SECRET_KEY=sk_test_replace_me
SETTLEMENT_STRIPE_API_BASE=https://api.stripe.com
SETTLEMENT_STRIPE_API_VERSION=
SETTLEMENT_STRIPE_TIMEOUT=30s
SETTLEMENT_STRIPE_MAX_RETRIES=3

# platform    — bill on the platform account, no Connect. The default: a
#               developer with a payment method pays for their own end users.
# direct      — invoice on the connected account; the developer is merchant of
#               record and the platform takes an application fee.
# destination — invoice on the platform account, transfer the net to the
#               developer; the platform is merchant of record.
SETTLEMENT_STRIPE_CHARGE_MODEL=platform

# Per-customer overrides, read from OpenMeter customer metadata.
SETTLEMENT_CONNECT_ACCOUNT_METADATA_KEY=stripe_connect_account_id
SETTLEMENT_CHARGE_MODEL_METADATA_KEY=stripe_charge_model
SETTLEMENT_STRIPE_CUSTOMER_METADATA_KEY=stripe_customer_id

# The platform's cut on Connect invoices. Ignored in platform mode.
SETTLEMENT_APPLICATION_FEE_BPS=0
SETTLEMENT_APPLICATION_FEE_FLAT_MINOR=0

SETTLEMENT_STRIPE_COLLECTION_METHOD=charge_automatically
SETTLEMENT_STRIPE_AUTO_ADVANCE=true
SETTLEMENT_STRIPE_DAYS_UNTIL_DUE=30
SETTLEMENT_STRIPE_STATEMENT_DESCRIPTOR_SUFFIX=

# ---------------------------------------------------------------------------
# Reconciliation sweep
# ---------------------------------------------------------------------------

# Catches invoices stranded by a dropped event. Set the interval to 0 to
# disable; MIN_AGE keeps the sweep from racing a live notification.
SETTLEMENT_RECONCILE_INTERVAL=15m
SETTLEMENT_RECONCILE_MIN_AGE=10m
SETTLEMENT_RECONCILE_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Admin console (served by the worker on SETTLEMENT_METRICS_ADDR)
# ---------------------------------------------------------------------------

# Empty disables /admin (404). Set a long random token for ops access.
# SETTLEMENT_ADMIN_TOKEN=
# SETTLEMENT_ADMIN_PRODUCER_URL=https://settlement-producer.example
# SETTLEMENT_ADMIN_OPENMETER_UI_URL=https://cloud.konghq.com/...
# SETTLEMENT_ADMIN_STRIPE_DASHBOARD_URL=https://dashboard.stripe.com
# SETTLEMENT_ADMIN_RAILWAY_URL=https://railway.app/project/...

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

SETTLEMENT_LOG_LEVEL=info
SETTLEMENT_LOG_FORMAT=json
